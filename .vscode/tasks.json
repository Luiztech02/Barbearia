{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Santo Bigode: iniciar aplicação",
      "type": "process",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "server.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Santo Bigode: testes Python",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "test_server.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "-m",
          "unittest",
          "test_server.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
